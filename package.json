{
  "name": "compy",
  "version": "0.0.0",
  "description": "An app for comparing things",
  "license": "MIT",
  "author": "KrysPaw",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w @compy/api",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/web"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "workerd@1.20260704.1": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
