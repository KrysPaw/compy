# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/d/prisma-config-env-vars.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/compy?schema=public"

# Web app origin (CORS + magic-link / OAuth redirects)
WEB_ORIGIN="http://localhost:3001"

# Public API origin used for Google OAuth redirect URI when GOOGLE_REDIRECT_URI is unset
API_PUBLIC_URL="http://localhost:3000"

# Optional Google OAuth (passwordless registered auth)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional Resend API key for magic-link email delivery (logs link to console when unset)
# RESEND_API_KEY=
# MAGIC_LINK_FROM_EMAIL=

# Set to true to always include magic link URL in API responses (useful in staging)
# AUTH_EXPOSE_MAGIC_LINK=true
